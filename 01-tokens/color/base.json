        "$value": "{color.palette.fx-green.500}",
        "$description": "品牌绿。用于信号、主操作和重点区块。",
        "$extensions": {
          "tier0": {
            "displayName": "Light Green"
          }
        }
      },
      "fx-green-deep": {
        "$value": "{color.palette.fx-green-deep}",
