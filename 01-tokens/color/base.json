{
  "color": {
    "$type": "color",
    "brand": {
      "$description": "品牌色。",
      "fx-green-500": {
        "$value": "{color.scale.fx-green.500}",
        "$description": "信号、实时数据、选中、重点区块——高饱和的黄绿色，品牌层面唯一的颜色。只以色块、圆点、粗条出现，上面放近黑文字。",
        "$extensions": {
          "tier0": {
            "displayName": "Light Green"
          }
        }
      },
      "fx-green-deep": {
        "$value": "{color.scale.fx-green-deep}",
        "$description": "白底上的绿色文字、线条、图标、Logo——比 Light Green 深一档，在白底上清晰可读。",
        "$extensions": {
          "tier0": {
            "displayName": "Deep Green"
          }
        }
      },
      "black-900": {
        "$value": "{color.scale.black.900}",
        "$description": "正文、标题、主操作、深色背景——接近纯黑的近黑色。",
        "$extensions": {
          "tier0": {
            "displayName": "Black"
          }
        }
      },
      "primary-white": {
        "$value": "{color.scale.primary-white}",
