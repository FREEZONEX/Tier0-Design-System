{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // "allowSyntheticDefaultImports": true,
    "paths": {
      "@tier0/ui": ["packages/ui"],
      "@tier0/ui/*": ["packages/ui/*"],
      "@tier0/hooks": ["packages/hooks"],
      "@tier0/hooks/*": ["packages/hooks/*"],
      "@tier0/theme": ["packages/theme"],
      "@tier0/theme/*": ["packages/theme/*"],
      "@tier0/grpc-schema/zod/*": ["packages/grpc-schema/generated-zod/*"],
      "@tier0/grpc-schema/*": ["packages/grpc-schema/generated/grpc/*"],
      "@tier0/utils/": ["packages/utils/"],
      "@tier0/utils/*": ["packages/utils/*"],
      "@tier0/business": ["packages/business/src/index.ts"],
      "@tier0/business/*": ["packages/business/src/*"],
      "@tier0/uns-agent-ui": ["packages/uns-agent-ui/src/index.ts"],
      "@tier0/uns-agent-ui/i18n/*": ["packages/uns-agent-ui/i18n/*"],
      "@tier0/uns-agent-ui/*": ["packages/uns-agent-ui/src/*"],
      "uns-foundation": ["packages/uns-foundation/src/index.ts"],
      "uns-foundation/*": ["packages/uns-foundation/src/uns/*"]
    }
  },
  "include": ["types"]
}
